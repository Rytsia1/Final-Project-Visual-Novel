-- SEEDING DATA DIALOG (SKENARIO BIMBINGAN DOSEN XIANG BAI)
INSERT INTO tbl_dialogue_nodes (node_id, npc_id, speaker_name, dialogue_text, req_language, req_etiquette)
VALUES (1001, 101, 'Xiang Bai', 'Kenzo, bagaimana progres analisis data untuk tugas mingguanmu? Jelaskan secara ringkas.', 0, 0);

