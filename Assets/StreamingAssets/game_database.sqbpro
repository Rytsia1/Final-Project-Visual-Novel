-- 1. EVENT RUMOR LEVEL 1: Peringatan Edelweiss (Node 2001)
INSERT INTO tbl_dialogue_nodes (node_id, npc_id, speaker_name, dialogue_text, req_language, req_etiquette)
VALUES (2001, 104, 'Edelweiss', 'Kenzo! Tunggu sebentar... Akhir-akhir ini kamu jarang kelihatan bergaul. Aku dengar dari anak-anak lain, namamu mulai sering dibicarakan di kantin. Hati-hati, jaga hubunganmu dengan teman lokal ya!', 0, 0);

INSERT INTO tbl_dialogue_options (option_id, node_id, option_text, next_node_id, effect_guanxi, effect_mianzi_penalty)
VALUES (201, 2001, 'Terima kasih peringatannya, Edel. Aku akan coba perbaiki komunikasi.', NULL, 5, 0);

-- 2. EVENT RUMOR LEVEL 3: Teguran Keras Dosen Xiang Bai (Node 3001)
INSERT INTO tbl_dialogue_nodes (node_id, npc_id, speaker_name, dialogue_text, req_language, req_etiquette)
VALUES (3001, 101, 'Xiang Bai', '[LEDAKAN RUMOR] Kenzo Pratama! Masuk ke ruangan saya. Sikap pasif dan pengabaian etika sosialmu sudah memicu friksi di departemen ini. Reputasi angkatanmu dipertaruhkan. Fokus dan perbaiki caramu berinteraksi!', 0, 0);

INSERT INTO tbl_dialogue_options (option_id, node_id, option_text, next_node_id, effect_guanxi, effect_mianzi_penalty)
VALUES (301, 3001, 'Minta maaf secara formal dan terima teguran akademik.', NULL, 0, 0);</sql><current_tab id="0"/></tab_sql></sqlb_project>
