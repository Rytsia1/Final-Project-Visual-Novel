<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="game_database.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="176"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title=".Browsables" custom_title="0" dock_id="1" table="0,10:Browsables"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011300ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">-- 1. TABEL PROFIL PEMAIN
CREATE TABLE IF NOT EXISTS tbl_player_profile (
    player_id INTEGER PRIMARY KEY AUTOINCREMENT,
    player_name TEXT NOT NULL,
    current_day INTEGER DEFAULT 1,
    current_time_block TEXT DEFAULT 'Pagi',
    global_rumor_level INTEGER DEFAULT 0
);

-- 2. TABEL STATUS PEMAIN
CREATE TABLE IF NOT EXISTS tbl_player_stats (
    stat_id INTEGER PRIMARY KEY AUTOINCREMENT,
    player_id INTEGER NOT NULL,
    language_proficiency INTEGER DEFAULT 20,
    cultural_etiquette INTEGER DEFAULT 15,
    mental_health INTEGER DEFAULT 80,
    physical_health INTEGER DEFAULT 100,
    academic_theoretical INTEGER DEFAULT 30,
    academic_practical INTEGER DEFAULT 40,
    FOREIGN KEY (player_id) REFERENCES tbl_player_profile (player_id)
);

-- 3. TABEL MASTER NPC
CREATE TABLE IF NOT EXISTS tbl_npc_list (
    npc_id INTEGER PRIMARY KEY,
    npc_name TEXT NOT NULL,
    npc_role TEXT NOT NULL,
    base_decay_rate INTEGER DEFAULT 5
);

-- 4. TABEL MATRIKS RELASI NPC
CREATE TABLE IF NOT EXISTS tbl_npc_relations (
    relation_id INTEGER PRIMARY KEY AUTOINCREMENT,
    player_id INTEGER NOT NULL,
    npc_id INTEGER NOT NULL,
    guanxi_score INTEGER DEFAULT 0,
    loneliness_meter INTEGER DEFAULT 0,
    rumor_contribution INTEGER DEFAULT 0,
    days_since_last_interaction INTEGER DEFAULT 0,
    FOREIGN KEY (player_id) REFERENCES tbl_player_profile (player_id),
    FOREIGN KEY (npc_id) REFERENCES tbl_npc_list (npc_id)
);

-- 5. TABEL NODE DIALOG
CREATE TABLE IF NOT EXISTS tbl_dialogue_nodes (
    node_id INTEGER PRIMARY KEY,
    npc_id INTEGER NOT NULL,
    speaker_name TEXT NOT NULL,
    dialogue_text TEXT NOT NULL,
    req_language INTEGER DEFAULT 0,
    req_etiquette INTEGER DEFAULT 0,
    FOREIGN KEY (npc_id) REFERENCES tbl_npc_list (npc_id)
);

-- 6. TABEL OPSI RESPON DIALOG
CREATE TABLE IF NOT EXISTS tbl_dialogue_options (
    option_id INTEGER PRIMARY KEY AUTOINCREMENT,
    node_id INTEGER NOT NULL,
    option_text TEXT NOT NULL,
    next_node_id INTEGER,
    effect_guanxi INTEGER DEFAULT 0,
    effect_mianzi_penalty INTEGER DEFAULT 0,
    FOREIGN KEY (node_id) REFERENCES tbl_dialogue_nodes (node_id)
);

