-- SEEDING DATA DIALOG (SKENARIO BIMBINGAN DOSEN XIANG BAI)
INSERT INTO tbl_dialogue_nodes (node_id, npc_id, speaker_name, dialogue_text, req_language, req_etiquette)
VALUES (1001, 101, 'Xiang Bai', 'Devano, bagaimana progres analisis data untuk tugas mingguanmu? Jelaskan secara ringkas.', 0, 0);

INSERT INTO tbl_dialogue_options (option_id, node_id, option_text, next_node_id, effect_guanxi, effect_mianzi_penalty)
VALUES (1, 1001, 'Sampaikan progres analisis data sekarang.', 1002, 0, 0);

INSERT INTO tbl_dialogue_nodes (node_id, npc_id, speaker_name, dialogue_text, req_language, req_etiquette)
VALUES (1002, 101, 'Xiang Bai', '[Rute A] Penjelasanmu terstruktur, metodis, dan disampaikan dengan rasa hormat. Lanjutkan ke tahap bimbingan berikutnya.', 30, 50);

INSERT INTO tbl_dialogue_nodes (node_id, npc_id, speaker_name, dialogue_text, req_language, req_etiquette)
VALUES (1003, 101, 'Xiang Bai', '[Rute B] Tata bahasamu lancar, tapi kamu menyela dan mendebat metodologi di depan umum tanpa etika! Jaga sopan santunmu.', 30, 0);

INSERT INTO tbl_dialogue_nodes (node_id, npc_id, speaker_name, dialogue_text, req_language, req_etiquette)
VALUES (1004, 101, 'Xiang Bai', '[Rute C] Kamu berbicara terbata-bata dan terminologi datamu keliru. Saya tidak memahami maksudmu. Perbaiki kemampuan bahasamu dulu.', 0, 0);

-- 1. EVENT RUMOR LEVEL 1: Peringatan Edelweiss (Node 2001)
INSERT INTO tbl_dialogue_nodes (node_id, npc_id, speaker_name, dialogue_text, req_language, req_etiquette)
VALUES (2001, 104, 'Edelweiss', 'Devano! Tunggu sebentar... Akhir-akhir ini kamu jarang kelihatan bergaul. Aku dengar dari anak-anak lain, namamu mulai sering dibicarakan di kantin. Hati-hati, jaga hubunganmu dengan teman lokal ya!', 0, 0);

INSERT INTO tbl_dialogue_options (option_id, node_id, option_text, next_node_id, effect_guanxi, effect_mianzi_penalty)
VALUES (201, 2001, 'Terima kasih peringatannya, Edel. Aku akan coba perbaiki komunikasi.', NULL, 5, 0);

-- 2. EVENT RUMOR LEVEL 3: Teguran Keras Dosen Xiang Bai (Node 3001)
INSERT INTO tbl_dialogue_nodes (node_id, npc_id, speaker_name, dialogue_text, req_language, req_etiquette)
VALUES (3001, 101, 'Xiang Bai', '[LEDAKAN RUMOR] Devano Baskara Pratama! Masuk ke ruangan saya. Sikap pasif dan pengabaian etika sosialmu sudah memicu friksi di departemen ini. Reputasi angkatanmu dipertaruhkan. Fokus dan perbaiki caramu berinteraksi!', 0, 0);

INSERT INTO tbl_dialogue_options (option_id, node_id, option_text, next_node_id, effect_guanxi, effect_mianzi_penalty)
VALUES (301, 3001, 'Minta maaf secara formal dan terima teguran akademik.', NULL, 0, 0);

-- 3. TABEL TELEMETRY LOGS (Bab 4)
CREATE TABLE IF NOT EXISTS tbl_telemetry_logs (
    log_id INTEGER PRIMARY KEY AUTOINCREMENT,
    player_id INTEGER NOT NULL,
    in_game_day INTEGER NOT NULL,
    time_block TEXT NOT NULL,
    event_type TEXT NOT NULL,
    ph INTEGER,
    mh INTEGER,
    language_proficiency INTEGER,
    cultural_etiquette INTEGER,
    academic_theoretical INTEGER,
    academic_practical INTEGER,
    global_rumor_level INTEGER,
    avg_guanxi REAL,
    details TEXT,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY(player_id) REFERENCES tbl_player_profile(player_id)
);

-- 4. DATA-DRIVEN STAT EVALUATOR
ALTER TABLE tbl_dialogue_options ADD COLUMN fail_mianzi_node_id INTEGER DEFAULT NULL;
ALTER TABLE tbl_dialogue_options ADD COLUMN fail_language_node_id INTEGER DEFAULT NULL;

UPDATE tbl_dialogue_options 
SET next_node_id = 1002,
    fail_mianzi_node_id = 1003,
    fail_language_node_id = 1004,
    effect_guanxi = 15,
    effect_mianzi_penalty = 20
WHERE option_id = 1;

-- Contoh Dialog Li Haoran (Node 4001)
INSERT INTO tbl_dialogue_nodes (node_id, npc_id, speaker_name, dialogue_text, req_language, req_etiquette)
VALUES (4001, 102, 'Li Haoran', 'Devano, algoritma optimasi graf ini rumit sekali. Kamu paham cara menyelesaikannya?', 0, 0);

INSERT INTO tbl_dialogue_options (option_id, node_id, option_text, next_node_id, fail_mianzi_node_id, fail_language_node_id, effect_guanxi, effect_mianzi_penalty)
VALUES (401, 4001, 'Tawarkan bantuan analisis algoritma secara terstruktur.', 4002, 4003, 4004, 20, 15);

INSERT INTO tbl_dialogue_nodes (node_id, npc_id, speaker_name, dialogue_text, req_language, req_etiquette)
VALUES (4002, 102, 'Li Haoran', 'Luar biasa penjelasanmu! Logikanya sangat rapi. Terima kasih banyak, Devano!', 35, 40);

INSERT INTO tbl_dialogue_nodes (node_id, npc_id, speaker_name, dialogue_text, req_language, req_etiquette)
VALUES (4003, 102, 'Li Haoran', 'Kamu memang bisa koding, tapi tidak perlu meremehkan usahaku di depan teman lain seperti itu...', 35, 0);

INSERT INTO tbl_dialogue_nodes (node_id, npc_id, speaker_name, dialogue_text, req_language, req_etiquette)
VALUES (4004, 102, 'Li Haoran', 'Maaf Devano, istilah teknis Mandarin yang kamu gunakan membuatku bingung. Kita tanyakan ke dosen saja nanti.', 0, 0);

-- 5. EVENT MILESTONE: Evaluasi Akademik Tengah Semester Hari ke-30 (Nodes 5001 - 5003)
INSERT INTO tbl_dialogue_nodes (node_id, npc_id, speaker_name, dialogue_text, req_language, req_etiquette)
VALUES 
(5001, 101, 'Xiang Bai', 'Hari ini genap 30 hari masa pertukaranmu. Rekapitulasi nilai teori dan praktikum laboratorium sudah keluar. Mari kita lihat evaluasimu.', 0, 0),
(5002, 101, 'Xiang Bai', 'Hasilnya memuaskan, Devano. Nilai teori dan praktikummu melampaui standar minimum. Kamu membuktikan dirimu layak ada di sini. Pertahankan momentummu di paruh kedua.', 0, 0),
(5003, 101, 'Xiang Bai', 'Saya harus jujur, Devano. Nilai kamu berada di bawah garis kelulusan. Mulai besok kamu berstatus Academic Probation. Jika tidak ada perbaikan signifikan di Hari ke-60, saya terpaksa merekomendasikan pemulangan lebih awal.', 0, 0);

INSERT INTO tbl_dialogue_options (option_id, node_id, option_text, next_node_id, effect_guanxi, effect_mianzi_penalty)
VALUES 
(5011, 5001, 'Saya siap mendengar hasilnya, Profesor.', 5002, 0, 0),
(5021, 5002, 'Terima kasih, Profesor. Saya akan terus bekerja keras.', NULL, 5, 0),
(5031, 5003, 'Saya mengerti, Profesor. Saya tidak akan menyerah.', NULL, 0, 0);</sql><current_tab id="0"/></tab_sql></sqlb_project>
