INSERT INTO tbl_dialogue_nodes (node_id, npc_id, speaker_name, dialogue_text, req_language, req_etiquette)
VALUES (1002, 101, 'Xiang Bai', '[Rute A] Penjelasanmu terstruktur, metodis, dan disampaikan dengan rasa hormat. Lanjutkan ke tahap bimbingan berikutnya.', 30, 50);

INSERT INTO tbl_dialogue_nodes (node_id, npc_id, speaker_name, dialogue_text, req_language, req_etiquette)
VALUES (1003, 101, 'Xiang Bai', '[Rute B] Tata bahasamu lancar, tapi kamu menyela dan mendebat metodologi di depan umum tanpa etika! Jaga sopan santunmu.', 30, 0);

INSERT INTO tbl_dialogue_nodes (node_id, npc_id, speaker_name, dialogue_text, req_language, req_etiquette)
